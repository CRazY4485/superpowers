# Ensure shell scripts always have LF line endings
*.sh text eol=lf
hooks/session-start text eol=lf
hooks/project-context text eol=lf
hooks/context-nudge text eol=lf
hooks/interview-context text eol=lf
hooks/git-checkpoint text eol=lf
hooks/checkpoint-turn text eol=lf
hooks/git-guard text eol=lf
hooks/commit-nudge text eol=lf
hooks/commit-gate text eol=lf
hooks/branch-guard text eol=lf
hooks/research-nudge text eol=lf
hooks/test-integrity text eol=lf
hooks/decision-lint text eol=lf
hooks/decision-gate text eol=lf
hooks/brief-check text eol=lf
hooks/commit-gates text eol=lf
hooks/doc-lint text eol=lf
hooks/doc-drift text eol=lf

# Ensure the polyglot wrapper keeps LF (it's parsed by both cmd and bash)
*.cmd text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.ps1 text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.gif binary
