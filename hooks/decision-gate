#!/usr/bin/env bash
# PreToolUse hook: lint decision records before they enter history.
#
# Blocks a commit whose decision log contains a decision with no stated reason,
# an "evidence" line that is really an assumption, a duplicate or dangling id,
# or a supersession recorded on one side only. Warns when two live decisions
# claim the same scope - that is a reconciliation to run, not a defect to fix
# blindly.
#
# Prints a PreToolUse payload on stdout, or nothing. Always exits 0.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

payload=$(cat 2>/dev/null || true)
[ -n "$payload" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

sep=$'\x1f'
parsed=$(printf '%s' "$payload" | node -e '
let raw = "";
process.stdin.on("data", (d) => { raw += d; });
process.stdin.on("end", () => {
  try {
    const p = JSON.parse(raw);
    const cmd = (p.tool_input && p.tool_input.command) || "";
    process.stdout.write(`${p.tool_name || ""}\u001f${cmd}`);
  } catch (error) {
    process.stdout.write("");
  }
});' 2>/dev/null)

[ -n "$parsed" ] || exit 0
tool_name="${parsed%%${sep}*}"
command_text="${parsed#*${sep}}"

case "$tool_name" in
    Bash | PowerShell) ;;
    *) exit 0 ;;
esac

printf '%s' "$command_text" | grep -qE 'git([[:space:]]+-[^[:space:]]+)*[[:space:]]+commit([[:space:]]|$)' || exit 0
git -C "$PROJECT_DIR" rev-parse --git-dir >/dev/null 2>&1 || exit 0

staged=$(git -C "$PROJECT_DIR" diff --cached --name-only 2>/dev/null || true)
[ -n "$staged" ] || exit 0

decision_files=$(printf '%s\n' "$staged" | grep -E '(^|/)(\.claude/context/decisions\.md$|memory-bank/decisions/.*\.md$|docs/decisions/.*\.md$)' || true)
[ -n "$decision_files" ] || exit 0

workdir=$(mktemp -d 2>/dev/null) || exit 0
trap 'rm -rf "$workdir"' EXIT

findings=""
while IFS= read -r file; do
    [ -n "$file" ] || continue
    staged_copy="${workdir}/$(printf '%s' "$file" | tr '/' '_')"
    git -C "$PROJECT_DIR" show ":${file}" > "$staged_copy" 2>/dev/null || continue
    # Report against the real path, not the temp copy.
    out=$(bash "${SCRIPT_DIR}/decision-lint" "$staged_copy" 2>/dev/null | sed "s#${staged_copy}#${file}#g")
    [ -n "$out" ] && findings+="${out}"$'\n'
done < <(printf '%s\n' "$decision_files")

[ -n "${findings//[[:space:]]/}" ] || exit 0

errors=$(printf '%s\n' "$findings" | grep '^ERROR ' || true)
warnings=$(printf '%s\n' "$findings" | grep '^WARN ' || true)

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

if [ -n "$errors" ]; then
    reason="This commit would record decisions that cannot be reviewed later:"$'\n'
    reason+="${errors}"$'\n'
    reason+="A decision without a stated reason, or resting on an assumption, is not a record - it is a guess that later reads as settled. Fix the entries: state why, name the source the reason rests on (the owner's own words, a measurement, a document section, an official page), and mark supersession on both entries."$'\n'
    reason+="If the reason genuinely is not known yet, ask your human partner rather than writing a plausible one."
    escaped=$(escape_for_json "$reason")
    printf '{\n'
    printf '  "hookSpecificOutput": {\n'
    printf '    "hookEventName": "PreToolUse",\n'
    printf '    "permissionDecision": "deny",\n'
    printf '    "permissionDecisionReason": "%s"\n' "$escaped"
    printf '  }\n'
    printf '}\n'
    exit 0
fi

message="Decision log needs reconciling before this lands:"$'\n'
message+="${warnings}"$'\n'
message+="Two live decisions on one scope means one of them is wrong, or the scopes are narrower than they look. Put both to your human partner in plain language - what each one decided, when, and why - and record the outcome as a supersession rather than leaving both standing. See superpowers:reconciling-decisions."
escaped=$(escape_for_json "$message")
printf '{\n'
printf '  "hookSpecificOutput": {\n'
printf '    "hookEventName": "PreToolUse",\n'
printf '    "additionalContext": "%s"\n' "$escaped"
printf '  }\n'
printf '}\n'

exit 0
