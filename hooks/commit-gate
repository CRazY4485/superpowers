#!/usr/bin/env bash
# PreToolUse hook: inspect what a `git commit` is about to record.
#
# Blocks two things that are expensive to undo once they are in history:
# credentials, and unresolved conflict markers. Warns about weaker signals and
# oversized files without getting in the way.
#
# Prints a PreToolUse payload on stdout, or nothing. Always exits 0.

set -uo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
MAX_FILE_BYTES="${SUPERPOWERS_COMMIT_MAX_FILE_BYTES:-5000000}"

payload=$(cat 2>/dev/null || true)
[ -n "$payload" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

sep=$'\x1f'
parsed=$(printf '%s' "$payload" | node -e '
let raw = "";
process.stdin.on("data", (d) => { raw += d; });
process.stdin.on("end", () => {
  try {
    const p = JSON.parse(raw);
    const cmd = (p.tool_input && p.tool_input.command) || "";
    process.stdout.write(`${p.tool_name || ""}\u001f${cmd}`);
  } catch (error) {
    process.stdout.write("");
  }
});' 2>/dev/null)

[ -n "$parsed" ] || exit 0
tool_name="${parsed%%${sep}*}"
command_text="${parsed#*${sep}}"

case "$tool_name" in
    Bash | PowerShell) ;;
    *) exit 0 ;;
esac

printf '%s' "$command_text" | grep -qE 'git([[:space:]]+-[^[:space:]]+)*[[:space:]]+commit([[:space:]]|$)' || exit 0
git -C "$PROJECT_DIR" rev-parse --git-dir >/dev/null 2>&1 || exit 0

staged_files=$(git -C "$PROJECT_DIR" diff --cached --name-only 2>/dev/null || true)
[ -n "$staged_files" ] || exit 0

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Findings are reported by name and location - never by value. Echoing a
# secret back into the transcript is another copy of the secret.
blockers=""
warnings=""

added_lines() {
    git -C "$PROJECT_DIR" diff --cached -- "$1" 2>/dev/null | grep '^+' | grep -v '^+++'
}

while IFS= read -r file; do
    [ -n "$file" ] || continue

    # Size is checked first: a binary blob has no added text lines to scan.
    blob=$(git -C "$PROJECT_DIR" rev-parse ":${file}" 2>/dev/null || true)
    if [ -n "$blob" ]; then
        size=$(git -C "$PROJECT_DIR" cat-file -s "$blob" 2>/dev/null || echo 0)
        if [ "${size:-0}" -gt "$MAX_FILE_BYTES" ]; then
            warnings+="- ${file}: ${size} bytes staged, over the ${MAX_FILE_BYTES} byte limit"$'\n'
        fi
    fi

    lines=$(added_lines "$file")
    [ -n "$lines" ] || continue

    if printf '%s\n' "$lines" | grep -qE '^\+(<<<<<<< |>>>>>>> )'; then
        blockers+="- ${file}: unresolved conflict marker"$'\n'
    fi

    if printf '%s\n' "$lines" | grep -qE 'AKIA[0-9A-Z]{16}'; then
        blockers+="- ${file}: AWS access key id"$'\n'
    fi
    if printf '%s\n' "$lines" | grep -qE 'BEGIN [A-Z ]*PRIVATE KEY'; then
        blockers+="- ${file}: private key block"$'\n'
    fi
    if printf '%s\n' "$lines" | grep -qE 'gh[pousr]_[A-Za-z0-9]{30,}'; then
        blockers+="- ${file}: GitHub token"$'\n'
    fi
    if printf '%s\n' "$lines" | grep -qE 'xox[baprs]-[A-Za-z0-9-]{10,}'; then
        blockers+="- ${file}: Slack token"$'\n'
    fi
    if printf '%s\n' "$lines" | grep -qE '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}'; then
        blockers+="- ${file}: API secret key"$'\n'
    fi

    if printf '%s\n' "$lines" | grep -qiE '(password|passwd|secret|api_?key|access_?token|auth_?token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{6,}["'"'"']'; then
        warnings+="- ${file}: a credential-shaped literal is assigned inline"$'\n'
    fi
done < <(printf '%s\n' "$staged_files")

if [ -n "$blockers" ]; then
    reason="This commit is blocked by what it would put into history:"$'\n'
    reason+="${blockers}"
    reason+="Fix the staged content, not the check: remove the credential from the file and rotate it if it was ever real, or finish resolving the conflict. Then stage again and commit."$'\n'
    reason+="If this is a placeholder or test fixture, say so to your human partner and commit with a value that cannot be mistaken for a live secret."
    escaped=$(escape_for_json "$reason")
    printf '{\n'
    printf '  "hookSpecificOutput": {\n'
    printf '    "hookEventName": "PreToolUse",\n'
    printf '    "permissionDecision": "deny",\n'
    printf '    "permissionDecisionReason": "%s"\n' "$escaped"
    printf '  }\n'
    printf '}\n'
    exit 0
fi

if [ -n "$warnings" ]; then
    message="Worth a look before this commit lands:"$'\n'
    message+="${warnings}"
    message+="Neither is fatal. Confirm the literal is not a live credential, and that the large file belongs in git rather than in storage or .gitignore."
    escaped=$(escape_for_json "$message")
    printf '{\n'
    printf '  "hookSpecificOutput": {\n'
    printf '    "hookEventName": "PreToolUse",\n'
    printf '    "additionalContext": "%s"\n' "$escaped"
    printf '  }\n'
    printf '}\n'
fi

exit 0
