#!/usr/bin/env bash
# PreToolUse hook: refuse a commit that makes the suite lie.
#
# The failure it exists for: a test stands in the way, so the test gets skipped,
# focused, deleted, or quietly stripped of assertions, and the change "passes".
# A suite that was weakened to fit the code is worse than no suite, because it
# still reports green.
#
# Blocks: newly skipped or focused tests, and a net loss of test functions.
# Warns: assertions removed without a test being removed.
# Escape hatch: `pragma: test-change <reason>` on the line, for the cases where
# retiring a test is the right call and the owner has agreed.
#
# Prints a PreToolUse payload on stdout, or nothing. Always exits 0.

set -uo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

payload=$(cat 2>/dev/null || true)
[ -n "$payload" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

sep=$'\x1f'
parsed=$(printf '%s' "$payload" | node -e '
let raw = "";
process.stdin.on("data", (d) => { raw += d; });
process.stdin.on("end", () => {
  try {
    const p = JSON.parse(raw);
    const cmd = (p.tool_input && p.tool_input.command) || "";
    process.stdout.write(`${p.tool_name || ""}\u001f${cmd}`);
  } catch (error) {
    process.stdout.write("");
  }
});' 2>/dev/null)

[ -n "$parsed" ] || exit 0
tool_name="${parsed%%${sep}*}"
command_text="${parsed#*${sep}}"

case "$tool_name" in
    Bash | PowerShell) ;;
    *) exit 0 ;;
esac

printf '%s' "$command_text" | grep -qE 'git([[:space:]]+-[^[:space:]]+)*[[:space:]]+commit([[:space:]]|$)' || exit 0
git -C "$PROJECT_DIR" rev-parse --git-dir >/dev/null 2>&1 || exit 0

staged=$(git -C "$PROJECT_DIR" diff --cached --name-only 2>/dev/null || true)
[ -n "$staged" ] || exit 0

is_test_path() {
    printf '%s' "$1" | grep -qE '(^|/)(tests?|spec|__tests__)/|(^|/)conftest\.py$|_test\.[a-z]+$|\.test\.[a-z]+$|_spec\.[a-z]+$|\.spec\.[a-z]+$|(^|/)test_[^/]+$'
}

# Diff lines of one file, minus anything the author explicitly justified.
diff_lines() {
    git -C "$PROJECT_DIR" diff --cached -- "$1" 2>/dev/null | grep -v 'pragma: test-change'
}

count_matches() {
    local text="$1" pattern="$2" n
    n=$(printf '%s\n' "$text" | grep -cE "$pattern" || true)
    [ -n "$n" ] || n=0
    printf '%s' "$n"
}

skip_pattern='(@pytest\.mark\.(skip|xfail)|@unittest\.skip|@Disabled|@Ignore|#\[ignore\]|\b(it|test|describe|context)\.(skip|only)\(|\bx(it|describe|test)\(|\bfit\(|\bfdescribe\(|t\.Skip\(|\.Skip\(\)|testing\.Short\(\))'
test_def_pattern='(\bdef test_|\bfunc Test[A-Z]|\b(it|test|describe)\(|\[Test\]|\bpublic void test)'
assertion_pattern='(\bassert\b|\bexpect\(|\bshould\b|assertEquals|assertTrue|assertFalse|XCTAssert|require\.(True|NoError|Equal)|\bt\.(Error|Fatal)f?\()'

blockers=""
warnings=""

while IFS= read -r file; do
    [ -n "$file" ] || continue
    is_test_path "$file" || continue

    lines=$(diff_lines "$file")
    [ -n "$lines" ] || continue

    added=$(printf '%s\n' "$lines" | grep '^+' | grep -v '^+++' || true)
    removed=$(printf '%s\n' "$lines" | grep '^-' | grep -v '^---' || true)

    skips_added=$(count_matches "$added" "$skip_pattern")
    skips_removed=$(count_matches "$removed" "$skip_pattern")
    if [ "$skips_added" -gt "$skips_removed" ]; then
        blockers+="- ${file}: a test was skipped, focused, or marked expected-to-fail"$'\n'
    fi

    defs_added=$(count_matches "$added" "$test_def_pattern")
    defs_removed=$(count_matches "$removed" "$test_def_pattern")
    if [ "$defs_removed" -gt "$defs_added" ]; then
        lost=$((defs_removed - defs_added))
        blockers+="- ${file}: ${lost} more test(s) removed than added"$'\n'
    fi

    asserts_added=$(count_matches "$added" "$assertion_pattern")
    asserts_removed=$(count_matches "$removed" "$assertion_pattern")
    if [ "$asserts_removed" -gt "$asserts_added" ] && [ "$defs_removed" -le "$defs_added" ]; then
        lost=$((asserts_removed - asserts_added))
        warnings+="- ${file}: ${lost} assertion(s) removed while the tests stayed"$'\n'
    fi
done < <(printf '%s\n' "$staged")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

if [ -n "$blockers" ]; then
    reason="This commit weakens the test suite:"$'\n'
    reason+="${blockers}"
    reason+="A test that stands in the way of a change is evidence about the change, not an obstacle to remove. Make the code satisfy the test, or - if the behaviour genuinely retired - say so to your human partner, get their agreement, and record why."$'\n'
    reason+="If this removal is the agreed outcome, mark the line with 'pragma: test-change <reason>' so the record shows a decision rather than a quiet deletion."
    escaped=$(escape_for_json "$reason")
    printf '{\n'
    printf '  "hookSpecificOutput": {\n'
    printf '    "hookEventName": "PreToolUse",\n'
    printf '    "permissionDecision": "deny",\n'
    printf '    "permissionDecisionReason": "%s"\n' "$escaped"
    printf '  }\n'
    printf '}\n'
    exit 0
fi

if [ -n "$warnings" ]; then
    message="Check before this commit lands:"$'\n'
    message+="${warnings}"
    message+="Removing an assertion narrows what the test proves. If the assertion was wrong, say why; if it was merely inconvenient, put it back."
    escaped=$(escape_for_json "$message")
    printf '{\n'
    printf '  "hookSpecificOutput": {\n'
    printf '    "hookEventName": "PreToolUse",\n'
    printf '    "additionalContext": "%s"\n' "$escaped"
    printf '  }\n'
    printf '}\n'
fi

exit 0
